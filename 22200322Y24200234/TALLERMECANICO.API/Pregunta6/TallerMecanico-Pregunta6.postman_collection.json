{
  "info": {
    "_postman_id": "d7e5c8b4-5d29-4f1b-91d8-7dcbf4f6a001",
    "name": "TallerMecanico API - Pregunta 6",
    "description": "Pruebas CRUD de TipoServicio y OrdenServicio para la Pregunta 6.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5026" },
    { "key": "tipoServicioId", "value": "1" },
    { "key": "ordenServicioId", "value": "1" },
    { "key": "vehiculoId", "value": "1" }
  ],
  "item": [
    {
      "name": "TipoServicioController",
      "item": [
        {
          "name": "GET - Listar tipos de servicio",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/TipoServicio" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Respuesta exitosa', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"] } }]
        },
        {
          "name": "POST - Crear tipo de servicio",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Diagnóstico general\",\n  \"precioBase\": 80.00\n}" }, "url": "{{baseUrl}}/api/TipoServicio" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Creado correctamente', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });", "if (pm.response.code === 200 || pm.response.code === 201) { pm.collectionVariables.set('tipoServicioId', pm.response.json().id); }"] } }]
        },
        {
          "name": "GET - Obtener tipo de servicio",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/TipoServicio/{{tipoServicioId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Encontrado', function () { pm.expect(pm.response.code).to.be.oneOf([200, 404]); });"] } }]
        },
        {
          "name": "PUT - Actualizar tipo de servicio",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"id\": {{tipoServicioId}},\n  \"nombre\": \"Diagnóstico y revisión\",\n  \"precioBase\": 95.00\n}" }, "url": "{{baseUrl}}/api/TipoServicio/{{tipoServicioId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Actualizado o no encontrado', function () { pm.expect(pm.response.code).to.be.oneOf([204, 404]); });"] } }]
        },
        {
          "name": "DELETE - Eliminar tipo de servicio",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/TipoServicio/{{tipoServicioId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Eliminado o no encontrado', function () { pm.expect(pm.response.code).to.be.oneOf([204, 404]); });"] } }]
        }
      ]
    },
    {
      "name": "OrdenServicioController",
      "item": [
        {
          "name": "GET - Listar órdenes de servicio",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/OrdenServicio" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Respuesta exitosa', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"] } }]
        },
        {
          "name": "POST - Crear orden de servicio",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"vehiculoId\": {{vehiculoId}},\n  \"tipoServicioId\": {{tipoServicioId}},\n  \"descripcionProblema\": \"Revisión preventiva del vehículo\",\n  \"costoEstimado\": 250.00,\n  \"estado\": \"Pendiente\"\n}" }, "url": "{{baseUrl}}/api/OrdenServicio" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Creado o datos relacionados inexistentes', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 404, 500]); });", "if (pm.response.code === 200 || pm.response.code === 201) { pm.collectionVariables.set('ordenServicioId', pm.response.json().id); }"] } }]
        },
        {
          "name": "GET - Obtener orden de servicio",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/OrdenServicio/{{ordenServicioId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Encontrado o no encontrado', function () { pm.expect(pm.response.code).to.be.oneOf([200, 404]); });"] } }]
        },
        {
          "name": "PUT - Actualizar orden de servicio",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"vehiculoId\": {{vehiculoId}},\n  \"tipoServicioId\": {{tipoServicioId}},\n  \"descripcionProblema\": \"Revisión preventiva actualizada\",\n  \"costoEstimado\": 280.00,\n  \"estado\": \"EnProceso\"\n}" }, "url": "{{baseUrl}}/api/OrdenServicio/{{ordenServicioId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Actualizado o no encontrado', function () { pm.expect(pm.response.code).to.be.oneOf([204, 404]); });"] } }]
        },
        {
          "name": "DELETE - Eliminar orden de servicio",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/OrdenServicio/{{ordenServicioId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Eliminado o no encontrado', function () { pm.expect(pm.response.code).to.be.oneOf([204, 404, 409, 500]); });"] } }]
        }
      ]
    }
  ]
}
